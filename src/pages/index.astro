---
// Komponen bawaan tetap dipakai
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// TAMBAHAN: Import fungsi untuk membaca postingan dari Keystatic/Content
import { getCollection } from 'astro:content';

// TAMBAHAN: Ambil semua postingan dan urutkan dari terbaru
const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} />
    </head>
    <body>
        <Header />
        
        <main style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
            
            <!-- Tombol Login Admin Keystatic -->
            <div style="margin-bottom: 2rem; text-align: right;">
                <a href="/keystatic" style="padding: 8px 16px; background: #ff5c39; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 14px;">📝 Login Keystatic</a>
            </div>

            <!-- DAFTAR POSTINGAN (Mengganti teks Hello Astronaut) -->
            {allPosts.map((post) => (
                <article style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #e2e8f0;">
                    <h2 style="margin: 0 0 0.5rem 0; font-size: 1.8rem;">
                        <a href={`/posts/${post.slug}`} style="color: #1a1a1a; text-decoration: none;">
                            {post.data.title}
                        </a>
                    </h2>
                    
                    <time style="display: block; color: #64748b; margin-bottom: 1rem; font-size: 0.9rem;">
                        📅 {post.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </time>

                    {post.data.description && (
                        <p style="color: #475569; line-height: 1.7; margin: 0;">
                            {post.data.description}
                        </p>
                    )}

                    <a href={`/posts/${post.slug}`} style="display: inline-block; margin-top: 1rem; color: #ff5c39; font-weight: 600; text-decoration: none;">
                        Baca Selengkapnya →
                    </a>
                </article>
            ))}

            <!-- Pesan kalau blog masih kosong -->
            {allPosts.length === 0 && (
                <p style="text-align: center; color: #94a3b8;">Belum ada postingan. Klik tombol Login di atas untuk mulai menulis.</p>
            )}

        </main>

        <Footer />
    </body>
</html>